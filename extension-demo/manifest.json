{
  "manifest_version": 3,
  "name": "Cornerwork",
  "version": "0.4.0",
  "minimum_chrome_version": "116",
  "description": "Coaching between classes: inbox, pre-class brief and owner view for gym staff. Imports Gymdesk attendance.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Open Cornerwork"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "dashboard.html",
  "content_scripts": [
    {
      "matches": [
        "https://app.gymdesk.com/manager/*"
      ],
      "js": [
        "gymdesk-embed.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html"
      ],
      "matches": [
        "https://app.gymdesk.com/*"
      ]
    }
  ]
}
